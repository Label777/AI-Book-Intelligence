# Ключ Claude API. Нужен для AI-движка анализа (src/pipeline) и контрольных прогонов (npm run eval).
ANTHROPIC_API_KEY=

# Модели по уровням. Если не заданы, берутся значения по умолчанию из src/pipeline/config.ts.
# AI_MODEL_FAST=
# AI_MODEL_MAIN=
# AI_MODEL_DEEP=

# Поиск книг (src/books). Всё необязательно: без этих значений поиск работает.
# Контакт для заголовка User-Agent в запросах к Open Library (по умолчанию — адрес репозитория).
# OPEN_LIBRARY_CONTACT=
# Ключ Google Books: без него запасной поиск работает в пределах общей квоты.
# GOOGLE_BOOKS_API_KEY=

# Каталог для результатов анализа. Если не задан, результаты хранятся в памяти
# и пропадают при перезапуске сервера.
# ANALYSIS_STORE_DIR=.data/analyses
